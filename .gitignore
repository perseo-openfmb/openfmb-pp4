# .old files
# Ignore old files
*.old

# .env files
# Ignore environment variable files
.env

# vscode settings
.vscode/

# timescaleDB database files
timescale_data/

# grafana runtime state (dashboards are versioned in config/grafana/ via provisioning)
grafana_data/

# python env
.venv/

# cache files
__pycache__/

# database backups: binary dumps (can be large). The folder is kept via
# backups/.gitkeep; carry the dumps across machines with cloud/USB/git-lfs,
# not plain git.
backups/*.dump
backups/*.partial

